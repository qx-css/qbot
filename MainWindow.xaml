<Window
    x:Class="QdBot.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="QdBot">
    <Grid Padding="22" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="QdBot" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Background="{ThemeResource SystemControlBackgroundAccentBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="未启动" Foreground="White" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="18" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer>
                <StackPanel Spacing="10">
                    <TextBlock Text="连接" FontSize="18" FontWeight="SemiBold" />
                    <TextBox x:Name="HostBox" Header="监听地址" />
                    <NumberBox x:Name="PortBox" Header="监听端口" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline" />
                    <TextBox x:Name="OneBotUrlBox" Header="OneBot API 地址" />
                    <PasswordBox x:Name="OneBotTokenBox" Header="OneBot Token" />

                    <TextBlock Text="AI" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <ComboBox x:Name="ModeBox" Header="模式" SelectedIndex="0">
                        <ComboBoxItem Content="AI" />
                        <ComboBoxItem Content="词库" />
                    </ComboBox>
                    <TextBox x:Name="AiBaseUrlBox" Header="AI Base URL" />
                    <PasswordBox x:Name="AiApiKeyBox" Header="AI API Key" />
                    <TextBox x:Name="AiModelBox" Header="AI 模型" />
                    <TextBox x:Name="WakePrefixBox" Header="触发前缀，可留空" />
                    <TextBox x:Name="OwnerJoinTextBox" Header="进群提示" />
                    <TextBox x:Name="SystemPromptBox" Header="系统提示词" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox x:Name="ReplyGroupCheck" Content="回复群聊" />
                        <CheckBox x:Name="ReplyPrivateCheck" Content="回复私聊" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="运行日志" FontSize="18" FontWeight="SemiBold" />
                <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,10,0,0" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" VerticalAlignment="Stretch" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <Button Content="保存配置" Click="SaveButton_Click" />
            <Button Content="启动" Click="StartButton_Click" />
            <Button Content="停止" Click="StopButton_Click" />
            <Button Content="测试 AI" Click="TestAiButton_Click" />
        </StackPanel>
    </Grid>
</Window>
